    51 00000047 E877000000                  call print_uint
    52                                  
    53                                      ; Print newline
    54 0000004C B801000000                  mov rax, 1
    55 00000051 BF01000000                  mov rdi, 1
    56 00000056 488D35(41000000)            lea rsi, [rel newline]
    57 0000005D BA01000000                  mov rdx, 1
    58 00000062 0F05                        syscall
    59                                  
    60 00000064 49FFC5                      inc r13
    61 00000067 EBB2                        jmp .loop_motors
    62                                  
    63                                  .clamp_check:
    64                                      ; Clamp maximum RPM
    65 00000069 488B05(21000000)            mov rax, [max_safe]
    66 00000070 4939C6                      cmp r14, rax
    67 00000073 4C0F47F0                    cmova r14, rax
    68                                  
    69                                      ; Print final safe RPM
