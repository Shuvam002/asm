    13                                      safe_msg_len equ $ - safe_msg
    14                                  
    15 00000041 0A                          newline db 10
    16                                  
    17                                  section .text
    18                                      global _start
    19                                  
    20                                  _start:
    21                                      ; Check whether system is armed
    22 00000000 8A05(00000000)              mov al, [status_reg]
    23 00000006 A801                        test al, 1
    24 00000008 0F84AB000000                jz .disarmed_exit
    25                                  
    26                                      ; Initialize loop
    27 0000000E 4C8D25(01000000)            lea r12, [rel motor_rpms]
    28 00000015 4531ED                      xor r13d, r13d
    29 00000018 4531F6                      xor r14d, r14d
    30                                  
    31                                  .loop_motors:
    32 0000001B 4983FD04                    cmp r13, 4
    33 0000001F 7348                        jae .clamp_check
    34                                  
    35                                      ; Load current motor RPM
    36 00000021 4F8B3CEC                    mov r15, [r12 + r13*8]
    37                                  
    38                                      ; Update maximum RPM
    39 00000025 4D39F7                      cmp r15, r14
    40 00000028 4D0F47F7                    cmova r14, r15
    41                                  
    42                                      ; Print "Motor RPM: "
    43 0000002C B801000000                  mov rax, 1
    44 00000031 BF01000000                  mov rdi, 1
    45 00000036 488D35(29000000)            lea rsi, [rel motor_msg]
    46 0000003D BA0B000000                  mov rdx, motor_msg_len
    47 00000042 0F05                        syscall
    48                                  
    49                                      ; Print actual RPM
