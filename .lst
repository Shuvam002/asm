     4                                  section .data
     5 00000000 05                          status_reg db 0b00000101
     6 00000001 AA050000000000002E-         motor_rpms dq 1450, 2350, 1820, 1950
     6 0000000A 090000000000001C07-
     6 00000013 0000000000009E0700-
     6 0000001C 0000000000         
     7 00000021 D007000000000000            max_safe   dq 2000
     8                                  
     9 00000029 4D6F746F722052504D-         motor_msg db "Motor RPM: "
