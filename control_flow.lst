     1                                  default rel
     2                                  
     3                                  section .data
     4 00000000 AA050000000000002E-         motor_rpms dq 1450, 2350, 0, 18446744073709551615 ; 4 unsigned 64-bit values
     4 00000009 090000000000000000-
     4 00000012 000000000000FFFFFF-
     4 0000001B FFFFFFFFFF         
     5                                  
     6                                  section .text
     7                                      global _start
     8                                  
     9                                  _start:
    10 00000000 488D1D(00000000)            lea rbx, [motor_rpms]               ; RBX = base address of motor_rpms array
    11 00000007 4831C9                      xor rcx, rcx                        ; RCX = loop counter i = 0
    12                                  
    13                                  .loop_print:
    14 0000000A 4883F904                    cmp rcx, 4                          ; Check if i >= 4
    15 0000000E 730E                        jae .exit                           ; Exit loop after printing all 4 elements
    16                                  
    17 00000010 488B3CCB                    mov rdi, [rbx + rcx*8]              ; Load motor_rpms[i] into 1st argument register RDI
    18 00000014 E80F000000                  call print_uint                     ; Print RDI as an unsigned integer (preserves RCX & RBX!)
    19                                  
    20 00000019 48FFC1                      inc rcx                             ; i++
    21 0000001C EBEC                        jmp .loop_print
    22                                  
    23                                  .exit:
    24 0000001E 4831FF                      xor rdi, rdi                        ; Exit code 0
    25 00000021 B83C000000                  mov rax, 60                         ; sys_exit
    26 00000026 0F05                        syscall
    27                                  
    28                                  ; -----------------------------------------------------------------------------
    29                                  ; Procedure: print_uint
    30                                  ; Input:     RDI = 64-bit unsigned integer to print (appends newline '\n')
    31                                  ; Preserves: RAX, RCX, RDX, RSI, RDI, R11 (safe to call inside any active loop)
    32                                  ; -----------------------------------------------------------------------------
    33                                  print_uint:
    34                                      ; 1. Prologue: Create stack frame and allocate 32-byte local character buffer
    35 00000028 55                          push rbp
    36 00000029 4889E5                      mov rbp, rsp
    37 0000002C 4883EC20                    sub rsp, 32                         ; Reserve [rbp-32 .. rbp-1] on the stack
    38                                  
    39                                      ; 2. Preserve registers modified by division and sys_write
    40 00000030 50                          push rax
    41 00000031 51                          push rcx
    42 00000032 52                          push rdx
    43 00000033 56                          push rsi
    44 00000034 57                          push rdi
    45 00000035 4153                        push r11                            ; Linux syscall clobbers RCX and R11
    46                                  
    47                                      ; 3. Point RSI to the end of the stack buffer and insert newline '\n'
    48 00000037 488D75FF                    lea rsi, [rbp - 1]
    49 0000003B C6060A                      mov byte [rsi], 10                  ; ASCII 10 = '\n'
    50                                  
    51 0000003E 4889F8                      mov rax, rdi                        ; Dividend = number to print
    52 00000041 B90A000000                  mov rcx, 10                         ; Divisor = 10
    53                                  
    54                                  .convert_loop:
    55 00000046 4831D2                      xor rdx, rdx                        ; Clear upper 64 bits of dividend (RDX:RAX)
    56 00000049 48F7F1                      div rcx                             ; RAX = quotient, RDX = remainder (0..9)
    57 0000004C 80C230                      add dl, '0'                         ; Convert numeric digit (0..9) to ASCII ('0'..'9')
    58 0000004F 48FFCE                      dec rsi                             ; Step backward 1 byte in stack buffer
    59 00000052 8816                        mov [rsi], dl                       ; Write ASCII byte onto the stack
    60 00000054 4885C0                      test rax, rax                       ; Check if quotient reached 0
    61 00000057 75ED                        jnz .convert_loop                   ; Continue until all digits are extracted
    62                                  
    63                                      ; 4. Calculate string length and print via sys_write(stdout, rsi, length)
    64 00000059 488D5500                    lea rdx, [rbp]                      ; RDX = end of buffer address
    65 0000005D 4829F2                      sub rdx, rsi                        ; RDX = total bytes written (digits + '\n')
    66                                  
    67 00000060 B801000000                  mov rax, 1                          ; Syscall 1 = sys_write
    68 00000065 BF01000000                  mov rdi, 1                          ; File descriptor 1 = stdout
    69 0000006A 0F05                        syscall
    70                                  
    71                                      ; 5. Epilogue: Restore registers in reverse order and tear down stack frame
    72 0000006C 415B                        pop r11
    73 0000006E 5F                          pop rdi
    74 0000006F 5E                          pop rsi
    75 00000070 5A                          pop rdx
    76 00000071 59                          pop rcx
    77 00000072 58                          pop rax
    78                                  
    79 00000073 4889EC                      mov rsp, rbp                        ; Deallocate 32-byte stack buffer
    80 00000076 5D                          pop rbp                             ; Restore caller's RBP
    81 00000077 C3                          ret                                 ; Pop return address into RIP
